# Copy this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL_ID=gemini-2.0-flash-lite
DATABASE_URL=sqlite:///./matdaanpath.db
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
RUN_DB_MIGRATIONS_ON_STARTUP=true
RUN_DB_SEED_ON_STARTUP=true
USE_SECRET_MANAGER=true
GEMINI_API_KEY_SECRET=matdaanpath-gemini-api-key
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_API_TOKEN=
ALLOW_INSECURE_ADMIN=false
CLOUD_TASKS_QUEUE_ID=
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_TARGET_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_TASKS_VERIFICATION_TOKEN=
API_CACHE_TTL_SECONDS=90
API_CACHE_MAX_ENTRIES=2000
